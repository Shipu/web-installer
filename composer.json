{
    "name": "shipu/web-installer",
    "description": "Laravel Web Installer",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Shipu Ahamed",
            "email": "shipuahamed01@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Shipu\\WebInstaller\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.28|^12.0",
        "spatie/laravel-package-tools": "^1.9",
        "livewire/livewire": "^3.5|^4.0",
        "filament/forms": "^4.0|^5.0",
        "filament/notifications": "^4.0|^5.0",
        "filament/schemas": "^4.0|^5.0",
        "filament/support": "^4.0|^5.0",
        "laravel/helpers": "^1.6"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Shipu\\WebInstaller\\WebInstallerServiceProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Shipu\\WebInstaller\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
